# Data Cleaning Pipeline Configuration

# LLM Provider Configuration
# OLLAMA_URL=http://localhost:11434/api/generate
# LLM_MODEL=llama3

# Security & Limits
# MAX_FILE_SIZE_MB=50
# MAX_ROW_DROP_PERCENTAGE=20.0
# MAX_COLUMN_DROP_COUNT=5

# Logging & Debugging
# LOG_LEVEL=INFO
# ENVIRONMENT=development

# Database Persistence
# DATABASE_URL=sqlite:///./pipeline.db
# For PostgreSQL: DATABASE_URL=postgresql://user:password@localhost/dbname
